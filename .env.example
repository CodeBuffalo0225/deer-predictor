# ── REQUIRED ────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── DATABASE ─────────────────────────────────────────────────────────────────
# SQLite file path — stays local, never committed to git
DATABASE_URL=file:./dev.db

# ── STORAGE ──────────────────────────────────────────────────────────────────
# Where trail cam photos and property maps are stored
UPLOAD_DIR=./data

# ── SERVER ───────────────────────────────────────────────────────────────────
SERVER_PORT=3001

# ── TRAIL CAM SYNC ──────────────────────────────────────────────────────────
SYNC_ENABLED=true
SYNC_POLL_INTERVAL_MS=900000

# Spypoint
SPYPOINT_API_KEY=
SPYPOINT_API_BASE=https://restapi.spypoint.com

# Moultrie (unofficial endpoints — may break)
MOULTRIE_EMAIL=
MOULTRIE_PASSWORD=
MOULTRIE_CIRCUIT_BREAKER_THRESHOLD=3
MOULTRIE_CIRCUIT_BREAKER_RESET_MS=1800000

# Universal Import
IMPORT_WATCH_DIR=~/DeerPredictor/import
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_CAM_SENDERS=

# Queue Backend (memory or redis)
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# No other API keys needed — Open-Meteo weather is free and keyless
# Model selection is handled in server/services/claudeClient.js
