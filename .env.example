# ── REQUIRED ────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── DATABASE ─────────────────────────────────────────────────────────────────
# SQLite file path — stays local, never committed to git
DATABASE_URL=file:./dev.db

# ── STORAGE ──────────────────────────────────────────────────────────────────
# Where trail cam photos and property maps are stored
UPLOAD_DIR=./data

# ── SERVER ───────────────────────────────────────────────────────────────────
SERVER_PORT=3001

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# No other API keys needed — Open-Meteo weather is free and keyless
# Model selection is handled in server/services/claudeClient.js
